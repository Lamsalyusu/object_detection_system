
# ---------------------------------------------------
# Application
# ---------------------------------------------------
# development | production | test
NODE_ENV=development
# Optional override for the FastAPI service (defaults to NODE_ENV)
APP_ENV=
# Native (non-Docker) runs only; docker compose wires these to the containers itself
AUTH_API_URL=http://localhost:8000
VISION_API_URL=
# Public URL of the web app, used in password reset and verification links
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------
# Security (required)
# ---------------------------------------------------
# Signs FastAPI JWTs (min 32 chars) and is Django's SECRET_KEY. Rotating it logs everyone out.
SECRET_KEY=
# Shared by Next.js, FastAPI and the vision service. FastAPI rejects every
# non-health request without it (503), so login, signup and replay all fail.
INTERNAL_API_TOKEN=
# Signs outbound alert webhooks (X-SmartVision-Signature). Optional in development.
WEBHOOK_SECRET=

# ---------------------------------------------------
# PostgreSQL (docker compose db + auth)
# ---------------------------------------------------
# Native FastAPI runs fall back to SQLite in development when these are unset.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=smart_vision_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port for psql/GUI tools (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=5432
# Optional full URL for native FastAPI runs; takes precedence over POSTGRES_*.
# Write it out literally (no ${...} expansion), e.g. postgresql+psycopg2://user:pass@localhost:5432/smart_vision_ai
DATABASE_URL=

# ---------------------------------------------------
# Email (FastAPI password reset / verification; legacy Django pages)
# ---------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
# Gmail: use an app password, never the account password
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
# Block sign-in until the email address is verified (only enforced when email is configured)
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------
# Abuse protection
# ---------------------------------------------------
# Per-client limits on login, signup and email endpoints (set false only for load tests)
RATE_LIMITS_ENABLED=true
# Set true only when a reverse proxy you control sets X-Forwarded-For; otherwise
# clients could forge it. Without it, all clients share one rate-limit bucket.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------
# Detection alerts (FastAPI)
# ---------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_CLASSES=knife,fire
ALERT_MIN_CONFIDENCE=0.5
ALERT_COOLDOWN_SECONDS=60

# ---------------------------------------------------
# Vision service (Django, legacy_django/)
# ---------------------------------------------------
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,vision
# true = no calls to Supabase/Groq from Django (compose default)
OFFLINE_MODE=true
RTSP_ALLOWED_HOSTS=
RTSP_MAX_STREAMS=50
RTSP_RECONNECT_DELAY_SECONDS=1.0

# ---------------------------------------------------
# LLM chat (Next.js /api/chat; legacy Django chat)
# ---------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------
# Supabase (legacy Django only, and only when OFFLINE_MODE=false)
# ---------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# New-style keys: sb_publishable_... / sb_secret_...
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Unused by the current app: legacy_django/backend/auth.py defines a verifier
# that is never called. Leave empty unless that code is wired back in.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------
# OAuth (legacy Django login pages only; not used by the Next.js app)
# ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback/

# ---------------------------------------------------
# Legacy Django 3D features (optional)
# ---------------------------------------------------
AIML_API_KEY=
IMGBB_API_KEY=
TRIPOSR_API_URL=
